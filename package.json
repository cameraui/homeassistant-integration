{
  "name": "@camera.ui/homeassistant-integration",
  "version": "0.0.0",
  "private": true,
  "description": "camera.ui home assistant integration",
  "type": "module",
  "scripts": {
    "audit": "npm audit fix",
    "format:python": "cd custom_components && ruff format && cd ..",
    "format": "npm run format:python",
    "install-updates": "npm i --save",
    "lint:python": "cd custom_components && ruff check --fix && uv run --quiet --python 3.14 --with-requirements ../requirements-dev.txt mypy --config-file ./mypy.ini cameraui && cd ..",
    "lint": "npm run lint:python",
    "release": "bash scripts/release.sh",
    "update": "updates --update ./"
  },
  "homepage": "https://github.com/cameraui/homeassistant-integration#readme",
  "bugs": {
    "url": "https://github.com/cameraui/homeassistant-integration/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cameraui/homeassistant-integration.git"
  },
  "license": "MIT",
  "author": "seydx",
  "devDependencies": {
    "updates": "^18.0.7"
  }
}
